rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /settings/{gameId} {
      allow read: if true;
      allow write: if true;
    }
    match /images/{imageId} {
      allow read: if true;
      allow write: if true;
    }
    match /players/{playerId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
