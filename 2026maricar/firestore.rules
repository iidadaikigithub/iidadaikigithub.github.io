rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // コースデータ: エディターとゲームが匿名で読み書きするため全許可
    // 本番では allow write: if request.auth != null; に変更推奨
    match /courses/{courseId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // キャラクターPNG参照用
    match /characters/{characterId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 必要なら全ドキュメント許可（テスト用ワイルドカード）
    // match /{document=**} {
    //   allow read, write: if true;
    // }
  }
}
